# Fixed split NPZ/JSON/CSV files are deliberately versioned because all models
# must use the same sample identities.

# Runtime artifacts and formal experiment runs stay local.
artifacts/**
!artifacts/checkpoints/
!artifacts/checkpoints/.gitkeep
!artifacts/logs/
!artifacts/logs/.gitkeep
experiments/*
!experiments/.gitkeep
runs/
*.log
*.pt
*.pth
*.ckpt
wandb/
mlruns/

# Result directories may grow quickly. Only the audited dataset overviews,
# report figures, paper-reproduction charts and the class-count table are public.
results/**
!results/dataset_overviews/
!results/dataset_overviews/*.png
!results/tables/
!results/tables/dataset_class_counts.csv
!results/figures/
!results/figures/*.png
!results/论文复现结果/
!results/论文复现结果/*.png
!results/论文复现结果/*.csv
!results/论文复现结果/*.md
!results/论文复现结果/各模型图/
!results/论文复现结果/各模型图/*.png
!results/数据集分布/
!results/数据集分布/README.md
!results/数据集分布/figures/
!results/数据集分布/figures/*.png
!results/数据集分布/生成三大数据集分布插图.py

# Historical stage materials stay local; the public repo only keeps the
# unified configuration under configs/ and the small frozen preprocessing states.
归档/

# Internal development docs are local-only.
docs/

# 运行产物（任何 outputs 目录、Joblib 序列化模型）体积大，仅保留在本地，不入库。
outputs/
*.joblib

# 课程作业的 Word/PDF 报告与渲染中间产物不入库，仅保留 markdown 源。
coursework/report/*.docx
coursework/report/*.pdf
coursework/report/rendered_*/
coursework/report/template_audit/
coursework/jupyter_runtime/

# 实验报告、内部索引与一次性课程脚本仅保留在本地，不进入公开仓库。
report/
使用说明.md
论文复现_内容索引.md
scripts/build_coursework_notebooks.py
scripts/build_coursework_report.py
scripts/execute_coursework_notebooks.py
