.pytest_cache/
.coverage
htmlcov/
.ipynb_checkpoints/
*.egg-info/
build/
dist/
.idea/
.vscode/
.codex/
.codex_tmp/
.agents/
*.code-workspace
.DS_Store
Thumbs.db
~$*
.env
.env.*

# Raw datasets are downloaded locally and must not be committed.
data/raw/*
!data/raw/README.md
!data/raw/SOURCES.csv
!data/raw/file_manifest.csv
!data/raw/KAGGLE_ARCHIVE_README.md
!data/raw/KAGGLE_ARCHIVE_CHECKSUMS.md

# Processed data are ignored by default. Only the small, frozen Pavia
# preprocessing states required for exact reproduction are versioned. The
# seed345 entries below are retained only so historical artifacts stay visible;
# every current experiment and new frozen route uses seed1442.
data/processed/**
!data/processed/.gitkeep
!data/processed/dataset_inventory.json
!data/processed/pavia_university/
!data/processed/pavia_university/fair24_6_70__seed345__standard_pca15_patch25/
!data/processed/pavia_university/fair24_6_70__seed345__standard_pca15_patch25/metadata.json
!data/processed/pavia_university/fair24_6_70__seed345__standard_pca15_patch25/preprocessing_state.npz
!data/processed/pavia_university/paper30__seed345__standard_pca15_patch25/
!data/processed/pavia_university/paper30__seed345__standard_pca15_patch25/metadata.json
!data/processed/pavia_university/paper30__seed345__standard_pca15_patch25/preprocessing_state.npz
!data/processed/pavia_university/fair24_6_70__seed345__standard_lda8_pixel/
!data/processed/pavia_university/fair24_6_70__seed345__standard_lda8_pixel/metadata.json
!data/processed/pavia_university/fair24_6_70__seed345__standard_lda8_pixel/preprocessing_state.npz
!data/processed/pavia_university/fair24_6_70__seed345__standard_lda8_patch25/
!data/processed/pavia_university/fair24_6_70__seed345__standard_lda8_patch25/metadata.json
!data/processed/pavia_university/fair24_6_70__seed345__standard_lda8_patch25/preprocessing_state.npz
!data/processed/pavia_university/paper30__seed345__standard_lda8_patch25/
!data/processed/pavia_university/paper30__seed345__standard_lda8_patch25/metadata.json
!data/processed/pavia_university/paper30__seed345__standard_lda8_patch25/preprocessing_state.npz
!data/processed/pavia_university/fair24_6_70__seed1442__standard_pca15_patch25/
!data/processed/pavia_university/fair24_6_70__seed1442__standard_pca15_patch25/metadata.json
!data/processed/pavia_university/fair24_6_70__seed1442__standard_pca15_patch25/preprocessing_state.npz
!data/processed/pavia_university/paper30__seed1442__standard_pca15_patch25/
!data/processed/pavia_university/paper30__seed1442__standard_pca15_patch25/metadata.json
!data/processed/pavia_university/paper30__seed1442__standard_pca15_patch25/preprocessing_state.npz
